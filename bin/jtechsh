#!/usr/bin/env bash
#
# JtechSH - Secure Intelligent Shell & Automation Platform
# Entry point
#
# This script locates the project root, sources core modules,
# and starts the interactive shell loop.

set -uo pipefail

# --- Resolve project root (works even if invoked via symlink) ---
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
export JTECHSH_ROOT="$(cd "$BIN_DIR/.." >/dev/null 2>&1 && pwd)"

# --- Source core modules ---
# shellcheck source=/dev/null
source "$JTECHSH_ROOT/src/core/config.sh"
# shellcheck source=/dev/null
source "$JTECHSH_ROOT/src/core/builtins.sh"
# shellcheck source=/dev/null
source "$JTECHSH_ROOT/src/core/dispatcher.sh"
# shellcheck source=/dev/null
source "$JTECHSH_ROOT/src/core/shell.sh"

# --- Entry ---
jtechsh::main "$@"
